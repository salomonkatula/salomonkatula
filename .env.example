# Configuration optionnelle pour l'envoi automatique d'e-mails via SMTP
# Si ces variables sont renseignées, le serveur envoie automatiquement un e-mail à l'adresse de réception
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Adresse e-mail privée de réception pour les messages du formulaire de contact
CONTACT_RECIPIENT_EMAIL=salomonkatula2@gmail.com
